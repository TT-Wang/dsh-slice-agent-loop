exports[`tape compaction > folds a span into an epoch marker and re-anchors affected files 1`] = `
"[epoch compacted: t-1..t-5 — 5 history entries removed; re-anchored files follow as fresh bases. Any folded turn is still readable verbatim: recall_turn({"turn": "<id>"}), or recall_search({"query": "..."}) when you do not know which turn]
[base f.py @sha256:9691cabdcc33 · 2 lines]

B
[end base f.py @sha256:9691cabdcc33]
[turn t-6 · task k · completed]
ask: 
[turn t-7 · task k · completed]
ask: 
[turn t-8 · task k · completed]
ask: 
[turn t-9 · task k · completed]
ask: 
"
`;

exports[`tape composition > composes base + patch back to the exact post-state without a trailing newline 1`] = `
[
  "[base f.py @sha256:8ff436def145 · 1 lines · no trailing newline]
x = 1
[end base f.py @sha256:8ff436def145]
",
  "[patch f.py -> @sha256:1431b986377b · no trailing newline]
--- a
+++ b
@@ -1 +1 @@
-x = 1
+x = 2

",
]
`;

exports[`tape patches > emits one hunk per changed region 1`] = `
"--- a
+++ b
@@ -1,3 +1,3 @@
 alpha
-beta
+BETA
 gamma
@@ -8,3 +8,3 @@
 theta
-iota
+IOTA
 kappa
"
`;

exports[`tape patches > survives difflib autojunk on a >200-line file 1`] = `
"--- a
+++ b
@@ -251,2 +251,2 @@
 pad
-end
+END!
"
`;

exports[`tape rendering > renders every entry kind 1`] = `
"[turn t-1 · task k · completed]
ask: first
[base dir/a file.py @sha256:8ff436def145 · 1 lines · no trailing newline]
x = 1
[end base dir/a file.py @sha256:8ff436def145]
[patch dir/a file.py -> @sha256:1431b986377b · no trailing newline]
--- a
+++ b
@@ -1 +1 @@
-x = 1
+x = 2

[external b.py -> @sha256:0123456789ab — changed after your last recorded edit this turn (a command/script modified it); the entry below re-anchors to the current on-disk truth]
[reply t-1 @sha256:a455a42ce858]
 …[+200 chars in sealed turn]… 
[end reply @sha256:a455a42ce858]
[reasoning t-1 — your own prior thinking, for continuity; not user-visible @sha256:32d74456b0c4]
first I checked the file, then I edited it
[end reasoning @sha256:32d74456b0c4]
[finding @f8dcd7ca2504 · task k]
config holds sk-123...cdef for staging
[knowledge — cross-session candidates recalled for the current task; leads, not current-world proof]
- lesson: rotate keys monthly
[end knowledge]
"
`;

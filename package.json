{
  "name": "@dsh-external/dsh-slice-agent-loop",
  "description": "Durable context retention and recall policy for the stock DeepSeek Harness agent loop",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./fold": {
      "types": "./lib/types/fold/index.d.ts",
      "default": "./lib/fold/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "!lib/lab/**",
    "!lib/types/lab/**",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TT-Wang/dsh-slice-agent-loop.git"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.gates.json",
    "test": "vitest run",
    "check:size": "node scripts/check-repo-size.mjs",
    "link:dsh": "node scripts/link-dsh.mjs",
    "verify:packed": "node scripts/validation/run-packed-smoke.mjs",
    "verify:master": "node scripts/validation/run-master-tests.mjs",
    "check:build": "npm run build && node scripts/check-build.mjs",
    "check:peers": "node scripts/check-peer-ranges.mjs",
    "check:docs": "node scripts/check-doc-anchors.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1 || 0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.7-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-spill-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-spill-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "semver": "^7.8.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.11",
    "yaml": "^2.9.1"
  },
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "sliceDevelopment": {
    "sourceOnlyPackages": [
      "@deepseek-ai/dsh-llm-deepseek"
    ]
  }
}

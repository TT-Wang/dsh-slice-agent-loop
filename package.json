{
  "name": "@dsh-external/dsh-slice-agent-loop",
  "description": "Durable context retention and recall policy for the stock DeepSeek Harness agent loop",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./fold": {
      "types": "./lib/types/fold/index.d.ts",
      "default": "./lib/fold/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "!lib/lab/**",
    "!lib/types/lab/**",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TT-Wang/dsh-slice-agent-loop.git"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "check:size": "node scripts/check-repo-size.mjs",
    "link:dsh": "node scripts/link-dsh.mjs",
    "verify:packed": "node scripts/validation/run-packed-smoke.mjs",
    "verify:master": "node scripts/validation/run-master-tests.mjs"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.3-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.11",
    "@deepseek-ai/dsh-session-projection": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-spill": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-spill-local": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-spill-policy": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-output-retention": "0.1.3-alpha.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.3-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    }
  },
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
